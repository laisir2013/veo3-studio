# ============================================
# VEO3-STUDIO 環境變數配置
# ============================================
# 複製此文件為 .env 並填入您的 API 密鑰
# ============================================

# ============================================
# 必要配置 - 這些是系統運行的基本需求
# ============================================

# 數據庫連接 (TiDB/MySQL)
DATABASE_URL=mysql://user:password@host:port/database?ssl={"rejectUnauthorized":true}

# OpenAI API (用於 LLM 功能)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# 視頻生成 API - 至少需要一個
# ============================================

# VectorEngine API (主要視頻生成)
VECTORENGINE_API_KEY=ve_xxxxxxxxxxxxxxxxxxxxxxxx

# Veo3 API 密鑰 (可配置多個，用逗號分隔)
VEO3_API_KEYS=key1,key2,key3

# ============================================
# 圖片生成 API
# ============================================

# FAL.AI API (圖片生成)
FAL_KEY=fal_xxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# 語音合成 API
# ============================================

# Kreado TTS API
KREADO_API_KEY=kreado_xxxxxxxxxxxxxxxx

# Fish Audio API (語音克隆)
FISH_AUDIO_API_KEY=fish_xxxxxxxxxxxxxxxx

# ============================================
# 存儲配置 - Cloudflare R2
# ============================================

# Cloudflare R2 存儲
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET_NAME=postudio-videos
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# ============================================
# 可選配置
# ============================================

# 服務器端口 (默認 5000)
PORT=5000

# 節點環境
NODE_ENV=production

# 會話密鑰 (用於 cookie 加密)
SESSION_SECRET=your-random-secret-key-here

# ============================================
# 第三方服務 (可選)
# ============================================

# Suno Music API (背景音樂生成)
SUNO_API_KEY=suno_xxxxxxxxxxxxxxxx

# 翻譯服務
DEEPL_API_KEY=deepl_xxxxxxxxxxxxxxxx

# ============================================
# 調試選項
# ============================================

# 啟用詳細日誌
DEBUG=false

# 跳過 API 驗證 (僅開發環境)
SKIP_API_VALIDATION=false
